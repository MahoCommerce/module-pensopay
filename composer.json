{
    "name": "mahocommerce/module-pensopay",
    "description": "PensoPay/QuickPay payment integration for Maho Commerce",
    "license": "OSL-3.0",
    "type": "maho-module",
    "conflict": {
        "mahocommerce/maho": "<26.11.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "mahocommerce/maho": ">=26.11.1",
        "mahocommerce/maho-phpstan-plugin": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "phpstan/phpstan-strict-rules": "*",
        "rector/rector": "*"
    },
    "config": {
        "allow-plugins": {
            "mahocommerce/maho-composer-plugin": true
        },
        "platform": {
            "php": "8.5.1"
        }
    },
    "require": {
        "php": ">=8.5.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
